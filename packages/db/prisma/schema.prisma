generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  BUSINESS
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  STUDENT
  PROFESSIONAL
  CREATOR
  BUSINESS_OWNER
  ENTREPRENEUR
  ATHLETE
  OTHER
}

enum GoalArea {
  CAREER
  SCHOOL
  BUSINESS
  FITNESS
  LEARNING
  MONEY
  CREATIVE
  PERSONAL
}

enum HelpArea {
  LEARNING
  PLANNING
  MEETING_PEOPLE
  DISCOVERING_PLACES
  EVENTS
  GOALS
  MONEY
  COMMUNITIES
  OPPORTUNITIES
}

enum ScheduleKind {
  CLASS
  WORK
  TRAINING
  COMMITMENT
  OTHER
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum MessagePolicy {
  EVERYONE
  FRIENDS
  NOBODY
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at")
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  profile                Profile?
  sessions               Session[]
  verificationTokens     VerificationToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id       String @id @default(cuid())
  userId   String @unique @map("user_id")
  username String @unique

  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")
  coverUrl    String? @map("cover_url")
  bio         String?
  occupation  String?

  userType UserType @default(OTHER) @map("user_type")

  countryCode String  @default("RW") @map("country_code")
  city        String?
  timezone    String  @default("Africa/Kigali")
  locale      String  @default("en")
  currency    String  @default("RWF")

  skills    String[]   @default([])
  goalAreas GoalArea[] @default([]) @map("goal_areas")
  helpAreas HelpArea[] @default([]) @map("help_areas")

  onboardingStep Int       @default(0) @map("onboarding_step")
  onboardedAt    DateTime? @map("onboarded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests      ProfileInterest[]
  scheduleBlocks ScheduleBlock[]
  privacy        PrivacySettings?
  goals          Goal[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  following        Follow[]        @relation("Following")
  followers        Follow[]        @relation("Followers")
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsA     Friendship[]    @relation("FriendshipA")
  friendshipsB     Friendship[]    @relation("FriendshipB")
  blocksMade       Block[]         @relation("BlocksMade")
  blocksReceived   Block[]         @relation("BlocksReceived")
  reportsMade      Report[]        @relation("ReportsMade")
  posts            Post[]
  reactions        PostReaction[]
  comments         Comment[]
  saves            PostSave[]
  pollVotes        PollVote[]

  @@index([countryCode, city])
  @@index([userType])
  @@map("profiles")
}

model Interest {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  category  String
  tint      String?
  sortOrder Int     @default(0) @map("sort_order")

  profiles ProfileInterest[]

  @@index([category])
  @@map("interests")
}

model ProfileInterest {
  profileId  String   @map("profile_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@map("profile_interests")
}

model ScheduleBlock {
  id        String       @id @default(cuid())
  profileId String       @map("profile_id")
  label     String
  kind      ScheduleKind @default(CLASS)

  dayOfWeek   Int @map("day_of_week")
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dayOfWeek])
  @@map("schedule_blocks")
}

model PrivacySettings {
  id        String @id @default(cuid())
  profileId String @unique @map("profile_id")

  profileVisibility    ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  messagePolicy        MessagePolicy     @default(EVERYONE) @map("message_policy")
  allowFriendRequests  Boolean           @default(true) @map("allow_friend_requests")
  showActivity         Boolean           @default(true) @map("show_activity")
  showInPeopleYouKnow  Boolean           @default(true) @map("show_in_people_you_know")
  personalizationOptIn Boolean           @default(true) @map("personalization_opt_in")

  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String              @id @default(cuid())
  userId     String              @map("user_id")
  purpose    VerificationPurpose
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum TaskStatus {
  TODO
  DOING
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  DROPPED
}

enum GoalHorizon {
  SHORT
  LONG
}

enum EventKind {
  PERSONAL
  STUDY
  TASK
  FIXED
}

enum NotificationCategory {
  IMPORTANT
  SOCIAL
  EVENTS
  LEARNING
  GOALS
  DISCOVER
  SYSTEM
}

model Goal {
  id          String      @id @default(cuid())
  profileId   String      @map("profile_id")
  title       String
  description String?
  area        GoalArea    @default(PERSONAL)
  horizon     GoalHorizon @default(SHORT)
  status      GoalStatus  @default(ACTIVE)
  targetDate  DateTime?   @map("target_date")
  achievedAt  DateTime?   @map("achieved_at")
  sortOrder   Int         @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]

  @@index([profileId, status])
  @@map("goals")
}

model Milestone {
  id        String    @id @default(cuid())
  goalId    String    @map("goal_id")
  title     String
  doneAt    DateTime? @map("done_at")
  sortOrder Int       @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("milestones")
}

model Task {
  id        String       @id @default(cuid())
  profileId String       @map("profile_id")
  goalId    String?      @map("goal_id")
  parentId  String?      @map("parent_id")

  title    String
  notes    String?
  category String?
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueAt       DateTime?  @map("due_at")
  completedAt DateTime?  @map("completed_at")
  recurrence  Recurrence @default(NONE)
  sortOrder   Int        @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  goal     Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parent   Task?           @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]          @relation("Subtasks")
  events   CalendarEvent[]

  @@index([profileId, status, dueAt])
  @@index([goalId])
  @@index([parentId])
  @@map("tasks")
}

model CalendarEvent {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  taskId    String?   @map("task_id")

  title       String
  description String?
  location    String?
  kind        EventKind @default(PERSONAL)

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")
  allDay  Boolean  @default(false) @map("all_day")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([profileId, startAt])
  @@map("calendar_events")
}

model Notification {
  id       String               @id @default(cuid())
  userId   String               @map("user_id")
  category NotificationCategory @default(SYSTEM)

  title  String
  body   String?
  href   String?
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, category])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  importantInApp Boolean @default(true) @map("important_in_app")
  socialInApp    Boolean @default(true) @map("social_in_app")
  eventsInApp    Boolean @default(true) @map("events_in_app")
  learningInApp  Boolean @default(true) @map("learning_in_app")
  goalsInApp     Boolean @default(true) @map("goals_in_app")
  discoverInApp  Boolean @default(true) @map("discover_in_app")
  systemInApp    Boolean @default(true) @map("system_in_app")

  emailDigest Boolean @default(false) @map("email_digest")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PostKind {
  TEXT
  IMAGE
  POLL
  PROJECT
  ACHIEVEMENT
  ANNOUNCEMENT
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
}

enum ReportTargetType {
  PROFILE
  POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Profile @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model FriendRequest {
  id            String              @id @default(cuid())
  fromProfileId String              @map("from_profile_id")
  toProfileId   String              @map("to_profile_id")
  status        FriendRequestStatus @default(PENDING)
  message       String?
  createdAt     DateTime            @default(now()) @map("created_at")
  respondedAt   DateTime?           @map("responded_at")

  from Profile @relation("SentRequests", fields: [fromProfileId], references: [id], onDelete: Cascade)
  to   Profile @relation("ReceivedRequests", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, status])
  @@map("friend_requests")
}

model Friendship {
  id         String   @id @default(cuid())
  profileAId String   @map("profile_a_id")
  profileBId String   @map("profile_b_id")
  createdAt  DateTime @default(now()) @map("created_at")

  profileA Profile @relation("FriendshipA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB Profile @relation("FriendshipB", fields: [profileBId], references: [id], onDelete: Cascade)

  @@unique([profileAId, profileBId])
  @@index([profileBId])
  @@map("friendships")
}

model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker Profile @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String           @map("reporter_id")
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id")
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now()) @map("created_at")
  reviewedAt   DateTime?        @map("reviewed_at")

  reporter Profile @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Post {
  id         String         @id @default(cuid())
  profileId  String         @map("profile_id")
  kind       PostKind       @default(TEXT)
  visibility PostVisibility @default(PUBLIC)

  body     String
  imageUrl String? @map("image_url")
  linkUrl  String? @map("link_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reactions   PostReaction[]
  comments    Comment[]
  saves       PostSave[]
  pollOptions PollOption[]

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model PollOption {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  label     String
  sortOrder Int      @default(0) @map("sort_order")

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([postId])
  @@map("poll_options")
}

model PollVote {
  optionId  String   @map("option_id")
  profileId String   @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")

  option  PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([optionId, profileId])
  @@index([profileId])
  @@map("poll_votes")
}

model PostReaction {
  postId    String       @map("post_id")
  profileId String       @map("profile_id")
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([postId, profileId])
  @@index([profileId])
  @@map("post_reactions")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  profileId String    @map("profile_id")
  parentId  String?   @map("parent_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([postId, createdAt])
  @@map("comments")
}

model PostSave {
  postId    String   @map("post_id")
  profileId String   @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([postId, profileId])
  @@index([profileId])
  @@map("post_saves")
}
